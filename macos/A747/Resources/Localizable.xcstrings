    "Press the button on the logger to mark a place.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط زر المسجّل لوضع علامة على مكان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke die Taste am Logger, um einen Ort zu markieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa el botón del registrador para marcar un lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur le bouton de l’enregistreur pour marquer un lieu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी जगह को चिह्नित करने के लिए लॉगर का बटन दबाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan tombol di logger untuk menandai tempat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi il pulsante sul logger per segnare un luogo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロガーのボタンを押すと場所をマークできます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ადგილის მოსანიშნად დააჭირეთ ლოგერის ღილაკს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Орынды белгілеу үшін логгердегі түймені басыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로거의 버튼을 눌러 장소를 표시하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij przycisk na loggerze, aby oznaczyć miejsce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione o botão do registrador para marcar um local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите кнопку на логгере, чтобы отметить место."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Притисните дугме на логеру да означите место."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir yeri işaretlemek için kaydedicideki düğmeye basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть кнопку на логері, щоб позначити місце."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下记录仪上的按钮即可标记地点。"
          }
        }
      }
    },
