    "All tracks on the logger will be erased after they are saved on this Mac.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُمسح كل المسارات على المسجّل بعد حفظها على جهاز Mac هذا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Tracks auf dem Logger werden gelöscht, nachdem sie auf diesem Mac gespeichert wurden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las rutas del registrador se borrarán después de guardarse en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les parcours de l’enregistreur seront effacés une fois enregistrés sur ce Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉगर के सभी ट्रैक इस Mac पर सहेजे जाने के बाद मिटा दिए जाएँगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua trek di logger akan dihapus setelah disimpan di Mac ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le tracce sul logger verranno cancellate dopo essere state salvate su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロガー上のすべてのトラックは、このMacに保存された後に消去されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ლოგერზე არსებული ყველა ტრეკი წაიშლება მას შემდეგ, რაც შეინახება ამ Mac-ზე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Логгердегі барлық трек осы Mac-қа сақталғаннан кейін өшіріледі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로거의 모든 트랙은 이 Mac에 저장된 후 지워집니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie ślady w loggerze zostaną usunięte po zapisaniu ich na tym Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as trilhas do registrador serão apagadas depois de salvas neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все треки на логгере будут стёрты после того, как сохранятся на этом Mac."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Све трасе на логеру биће обрисане када се сачувају на овом Mac-у."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedicideki tüm rotalar bu Mac'e kaydedildikten sonra silinecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі треки на логері буде стерто після збереження на цьому Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录仪上的所有轨迹将在保存到这台 Mac 后被清除。"
          }
        }
      }
    },
