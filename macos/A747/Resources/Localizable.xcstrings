    "The log has passed the real memory size. The oldest points were overwritten.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجاوز السجل الحجم الحقيقي للذاكرة. كُتب فوق أقدم النقاط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Log hat die tatsächliche Speichergröße überschritten. Die ältesten Punkte wurden überschrieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro ha superado el tamaño real de la memoria. Los puntos más antiguos se sobrescribieron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le journal a dépassé la taille réelle de la mémoire. Les points les plus anciens ont été écrasés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉग मेमोरी के वास्तविक आकार से आगे निकल गया। सबसे पुराने पॉइंट ओवरराइट हो गए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Log melampaui ukuran memori sebenarnya. Titik tertua telah ditimpa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il registro ha superato la dimensione reale della memoria. I punti più vecchi sono stati sovrascritti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログが実際のメモリ容量を超えました。最も古いポイントは上書きされています。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ლოგმა გადააჭარბა მეხსიერების რეალურ ზომას. უძველესი წერტილები გადაიწერა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лог жадтың нақты көлемінен асып кетті. Ең ескі нүктелер қайта жазылды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그가 실제 메모리 크기를 넘었습니다. 가장 오래된 포인트가 덮어쓰여졌습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziennik przekroczył rzeczywisty rozmiar pamięci. Najstarsze punkty zostały nadpisane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O registro passou do tamanho real da memória. Os pontos mais antigos foram sobrescritos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лог превысил реальный объём памяти. Самые старые точки затёрты."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис је прешао стварну величину меморије. Најстарије тачке су преписане."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük, belleğin gerçek boyutunu aştı. En eski noktaların üzerine yazıldı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лог перевищив реальний обсяг пам’яті. Найстаріші точки перезаписано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日志已超出实际存储容量。最早的轨迹点已被覆盖。"
          }
        }
      }
    },
    "The log is downloaded and saved first. Erasing happens only if the download succeeds.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُنزَّل السجل ويُحفظ أولًا. لا يتم المسح إلا إذا نجح التنزيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Log wird zuerst heruntergeladen und gespeichert. Gelöscht wird nur, wenn der Download gelingt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero se descarga y guarda el registro. Solo se borra si la descarga tiene éxito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le journal est d’abord téléchargé et enregistré. L’effacement n’a lieu que si le téléchargement réussit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले लॉग डाउनलोड करके सहेजा जाता है। मिटाना तभी होता है जब डाउनलोड सफल हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Log diunduh dan disimpan terlebih dahulu. Penghapusan hanya dilakukan jika unduhan berhasil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima il registro viene scaricato e salvato. La cancellazione avviene solo se il download riesce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずログをダウンロードして保存します。消去はダウンロードが成功した場合にのみ行われます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯერ ლოგი ჩამოიტვირთება და შეინახება. წაშლა ხდება მხოლოდ წარმატებული ჩამოტვირთვის შემდეგ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алдымен лог жүктеліп, сақталады. Өшіру жүктеу сәтті болса ғана орындалады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 로그를 다운로드하고 저장합니다. 다운로드가 성공한 경우에만 지웁니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw dziennik jest pobierany i zapisywany. Czyszczenie następuje tylko po udanym pobraniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro o registro é baixado e salvo. O apagamento só acontece se o download der certo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала лог скачивается и сохраняется. Стирание выполняется, только если скачивание прошло успешно."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис се прво преузима и чува. Брисање се врши само ако преузимање успе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük önce indirilir ve kaydedilir. Silme yalnızca indirme başarılı olursa yapılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку лог завантажується й зберігається. Стирання виконується лише після успішного завантаження."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先下载并保存日志。只有下载成功后才会清除。"
          }
        }
      }
    },
    "The logger did not answer (%@).": {
