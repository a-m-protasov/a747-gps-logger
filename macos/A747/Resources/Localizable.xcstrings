    "Logging is off. Move the logger's switch to LOG to record tracks.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التسجيل متوقف. حرّك مفتاح المسجّل إلى LOG لتسجيل المسارات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufzeichnung ist aus. Stelle den Schalter des Loggers auf LOG, um Tracks aufzuzeichnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro está desactivado. Pon el interruptor del registrador en LOG para grabar rutas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement est désactivé. Placez l’interrupteur de l’enregistreur sur LOG pour enregistrer des parcours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग बंद है। ट्रैक रिकॉर्ड करने के लिए लॉगर का स्विच LOG पर करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perekaman mati. Geser sakelar logger ke LOG untuk merekam trek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione è disattivata. Sposta l’interruttore del logger su LOG per registrare le tracce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録はオフです。トラックを記録するにはロガーのスイッチをLOGにしてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩაწერა გამორთულია. ტრეკების ჩასაწერად ლოგერის გადამრთველი გადაიყვანეთ LOG-ზე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазу өшірулі. Трек жазу үшін логгер ауыстырғышын LOG күйіне қойыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록이 꺼져 있습니다. 트랙을 기록하려면 로거의 스위치를 LOG로 옮기세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapis jest wyłączony. Przestaw przełącznik loggera na LOG, aby zapisywać ślady."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação está desligada. Coloque a chave do registrador em LOG para gravar trilhas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись выключена. Переведите переключатель логгера в положение LOG, чтобы записывать треки."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Записивање је искључено. Пребаците прекидач логера на LOG да бисте снимали трасе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt kapalı. Rota kaydetmek için kaydedicinin anahtarını LOG konumuna getirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис вимкнено. Переведіть перемикач логера в положення LOG, щоб записувати треки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录已关闭。将记录仪的开关拨到 LOG 才能记录轨迹。"
          }
        }
      }
    },
