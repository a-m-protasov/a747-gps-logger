    "Unsupported log format %@. Satellite details (SID) are not supported.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنسيق سجل غير مدعوم %@. بيانات الأقمار الصناعية (SID) غير مدعومة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht unterstütztes Log-Format %@. Satellitendaten (SID) werden nicht unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato de registro no compatible %@. Los datos de satélites (SID) no son compatibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Format de journal non pris en charge %@. Les données satellites (SID) ne sont pas prises en charge."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "असमर्थित लॉग फ़ॉर्मैट %@। उपग्रह डेटा (SID) समर्थित नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Format log tidak didukung %@. Data satelit (SID) tidak didukung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato di registro non supportato %@. I dati sui satelliti (SID) non sono supportati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サポートされていないログ形式 %@。衛星データ（SID）には対応していません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ლოგის მხარდაუჭერელი ფორმატი %@. თანამგზავრების მონაცემები (SID) არ არის მხარდაჭერილი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолдау көрсетілмейтін лог пішімі %@. Спутник деректері (SID) қолданылмайды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원되지 않는 로그 형식 %@. 위성 데이터(SID)는 지원되지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieobsługiwany format dziennika %@. Dane satelitów (SID) nie są obsługiwane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato de registro não suportado %@. Dados de satélites (SID) não são suportados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неподдерживаемый формат лога %@. Данные о спутниках (SID) не поддерживаются."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Неподржан формат записа %@. Подаци о сателитима (SID) нису подржани."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteklenmeyen günlük biçimi %@. Uydu verileri (SID) desteklenmiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Непідтримуваний формат логу %@. Дані про супутники (SID) не підтримуються."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持的日志格式 %@。不支持卫星数据（SID）。"
          }
        }
      }
    },
