    "Logger not found. Check that the cable carries data, not only power.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعثر على المسجّل. تحقّق من أن الكبل ينقل البيانات وليس للشحن فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Logger nicht gefunden. Prüfe, ob das Kabel Daten überträgt und nicht nur lädt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encuentra el registrador. Comprueba que el cable transmite datos y no solo carga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistreur introuvable. Vérifiez que le câble transmet des données et ne fait pas que charger."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉगर नहीं मिला। जाँचें कि केबल डेटा भेजती है, सिर्फ़ चार्ज नहीं करती।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Logger tidak ditemukan. Pastikan kabel mengirim data, bukan hanya mengisi daya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Logger non trovato. Verifica che il cavo trasmetta dati e non serva solo per la ricarica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロガーが見つかりません。ケーブルが充電専用ではなくデータ通信に対応しているか確認してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ლოგერი ვერ მოიძებნა. შეამოწმეთ, რომ კაბელი მონაცემებს გადასცემს და არა მხოლოდ ტენავს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Логгер табылмады. Кабель тек зарядтап қана қоймай, деректерді де беретінін тексеріңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로거를 찾을 수 없습니다. 케이블이 충전 전용이 아니라 데이터 전송을 지원하는지 확인하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono loggera. Sprawdź, czy kabel przesyła dane, a nie tylko ładuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrador não encontrado. Verifique se o cabo transmite dados, e não só carrega."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Логгер не найден. Проверьте, что кабель передаёт данные, а не только заряжает."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Логер није пронађен. Проверите да кабл преноси податке, а не само пуни."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedici bulunamadı. Kablonun yalnızca şarj etmediğini, veri de aktardığını kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Логер не знайдено. Перевірте, що кабель передає дані, а не лише заряджає."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到记录仪。请确认数据线能传输数据，而不只是充电。"
          }
        }
      }
    },
