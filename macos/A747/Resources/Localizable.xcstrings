    "If nothing happens, try another cable: many cables only charge.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن لم يحدث شيء، جرّب كبلًا آخر: كثير من الكبلات للشحن فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn nichts passiert, probiere ein anderes Kabel: Viele Kabel laden nur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no pasa nada, prueba otro cable: muchos cables solo cargan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rien ne se passe, essayez un autre câble : beaucoup de câbles ne font que charger."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर कुछ न हो, तो दूसरी केबल आज़माएँ: कई केबल सिर्फ़ चार्ज करती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika tidak terjadi apa-apa, coba kabel lain: banyak kabel hanya untuk mengisi daya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se non succede nulla, prova un altro cavo: molti cavi servono solo per la ricarica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も起こらない場合は別のケーブルを試してください。充電専用のケーブルも多くあります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თუ არაფერი ხდება, სცადეთ სხვა კაბელი: ბევრი კაბელი მხოლოდ ტენავს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ештеңе болмаса, басқа кабельді байқап көріңіз: көп кабельдер тек зарядтайды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무 반응이 없으면 다른 케이블을 사용해 보세요. 충전만 되는 케이블이 많습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli nic się nie dzieje, spróbuj innego kabla: wiele kabli tylko ładuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se nada acontecer, tente outro cabo: muitos cabos só carregam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если ничего не происходит, попробуйте другой кабель: многие кабели только заряжают."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако се ништа не дешава, пробајте други кабл: многи каблови само пуне."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey olmazsa başka bir kablo deneyin: birçok kablo yalnızca şarj eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо нічого не відбувається, спробуйте інший кабель: багато кабелів лише заряджають."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果没有反应，请换一根数据线：很多线只能充电。"
          }
        }
      }
    },
