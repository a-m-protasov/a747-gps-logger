    "Turn the logger on and connect it to this Mac with a USB data cable. It will appear here automatically.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل المسجّل ووصّله بجهاز Mac هذا بكبل USB للبيانات. سيظهر هنا تلقائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte den Logger ein und verbinde ihn mit einem USB-Datenkabel mit diesem Mac. Er erscheint hier automatisch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enciende el registrador y conéctalo a este Mac con un cable USB de datos. Aparecerá aquí automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allumez l’enregistreur et branchez-le à ce Mac avec un câble USB de données. Il apparaîtra ici automatiquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉगर चालू करें और उसे USB डेटा केबल से इस Mac से जोड़ें। यह अपने आप यहाँ दिखाई देगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan logger dan hubungkan ke Mac ini dengan kabel data USB. Logger akan muncul di sini secara otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accendi il logger e collegalo a questo Mac con un cavo USB dati. Comparirà qui automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロガーの電源を入れ、データ通信用USBケーブルでこのMacに接続してください。自動的にここに表示されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩართეთ ლოგერი და შეაერთეთ ამ Mac-თან მონაცემთა USB კაბელით. ის აქ ავტომატურად გამოჩნდება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Логгерді қосып, оны осы Mac-қа деректер USB кабелімен жалғаңыз. Ол мұнда автоматты түрде пайда болады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로거를 켜고 데이터용 USB 케이블로 이 Mac에 연결하세요. 자동으로 여기에 나타납니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz logger i podłącz go do tego Maca kablem USB do transmisji danych. Pojawi się tutaj automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligue o registrador e conecte-o a este Mac com um cabo USB de dados. Ele aparecerá aqui automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите логгер и подключите его к этому Mac USB-кабелем для передачи данных. Он появится здесь автоматически."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Укључите логер и повежите га са овим Mac-ом USB каблом за податке. Појавиће се овде аутоматски."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydediciyi açın ve bir USB veri kablosuyla bu Mac'e bağlayın. Burada otomatik olarak görünecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть логер і під’єднайте його до цього Mac USB-кабелем для передачі даних. Він з’явиться тут автоматично."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开记录仪，并用 USB 数据线连接到这台 Mac。它会自动显示在这里。"
          }
        }
      }
    },
