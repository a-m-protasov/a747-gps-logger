    "Battery level is not reported by this logger.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُبلغ هذا المسجّل عن مستوى البطارية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Logger meldet keinen Akkustand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este registrador no informa del nivel de batería."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet enregistreur n’indique pas le niveau de batterie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह लॉगर बैटरी स्तर नहीं बताता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Logger ini tidak melaporkan level baterai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo logger non indica il livello della batteria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このロガーはバッテリー残量を報告しません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს ლოგერი ბატარეის დონეს არ აცნობებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл логгер батарея деңгейін хабарламайды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 로거는 배터리 잔량을 알려주지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten logger nie podaje poziomu baterii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este registrador não informa o nível da bateria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот логгер не сообщает уровень заряда."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Овај логер не пријављује ниво батерије."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kaydedici pil seviyesini bildirmiyor."
          }
